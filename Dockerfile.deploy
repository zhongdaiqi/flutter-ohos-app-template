# =============================================================================
# 部署镜像：即开即用的 Flutter Web 应用（nginx + build/web/）
#
# 安全：最终镜像只有 nginx:alpine + build/web/ 静态文件。
# 不含 Flutter SDK、entrypoint.sh、签名代码、密钥。
# 任何下游用户拉取都不会拿到构建凭据。
#
# 构建（需源码 + web builder 镜像）：
#   docker build -f Dockerfile.deploy -t flutter-web-app .
#
# 即开即用（拉现成的）：
#   docker run -p 8080:80 zhongdaiqi/flutter-ohos-app-template:web-latest
# =============================================================================

# ── Stage 1: 用 Web Builder 镜像打 Flutter web 产物 ─────────────────────
FROM zhongdaiqi/flutter-ohos-builder:web-latest AS builder

WORKDIR /workspace
COPY . .

RUN /entrypoint.sh \
    --flutter-version 3.41.10-ohos-1.0.1 \
    --ohos-api 26 \
    --build-target web \
    --build-mode release \
    --bundle-name com.zhongdaiqi.app \
    --app-name flutter-ohos-app-template

# ── Stage 2: nginx 托管（无 SDK、无密钥） ────────────────────────────────
FROM nginx:alpine

COPY --from=builder /workspace/build/web /usr/share/nginx/html

RUN printf 'server {\n\
    listen       80;\n\
    server_name  localhost;\n\
    root         /usr/share/nginx/html;\n\
    index        index.html;\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
    location ~* \\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, immutable";\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]