# Signing material — NEVER commit these.
# android/key.properties is generated by the builder at CI time and contains
# plaintext storePassword/keyPassword. The builder deletes it when the container
# exits, but this entry is the second line of defence.
android/key.properties
*.jks
*.p12
*.pfx
*.keystore
