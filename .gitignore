# Flutter/Dart
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/

# Signing material — NEVER commit these.
# android/key.properties is generated by the builder at CI time and contains
# plaintext storePassword/keyPassword. The builder deletes it when the container
# exits, but this entry is the second line of defence.
android/key.properties
# Same for OHOS: the builder injects hvigor signingConfigs (plaintext
# keyPassword/storePassword) into ohos/build-profile.json5, which lives in the
# MOUNTED workspace. The builder redacts it when the container exits; this is the
# second line of defence. ohos/ itself is generated by `flutter create`, so it is
# untracked — which makes it dangerously easy to `git add -A` by accident.
ohos/build-profile.json5
*.jks
*.p12
*.pfx
*.keystore
flutter-ohos-build.log

